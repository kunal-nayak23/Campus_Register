# Local development only. Replace before deploying to AWS.
SECRET_KEY=change-this-to-a-long-random-secret-for-production

# For Phase 1: leave DATABASE_URL unset to use local SQLite (instance/students.db).
# For Phase 2, set the URL after provisioning RDS MySQL and creating the database:
# DATABASE_URL=mysql+pymysql://studentapp:URL_ENCODED_PASSWORD@YOUR_RDS_ENDPOINT:3306/student_registration?charset=utf8mb4

# Set FLASK_ENV=production on EC2 to enforce a non-default SECRET_KEY.
# FLASK_ENV=production

# Set to true ONLY after HTTPS is configured; on plain HTTP it breaks every form (CSRF 400 error).
# SESSION_COOKIE_SECURE=false
